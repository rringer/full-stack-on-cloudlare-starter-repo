/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "user-application",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/auth*", "/trpc*", "/click-socket"]
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "stage": {
      "vars": {
        "STRIPE_PRODUCT_BASIC": "price_1S4S1sPo0S91W8mPiGQtKecK",
        "STRIPE_PRODUCT_PRO": "price_1S4S3YPo0S91W8mPb2OABcaI",
        "STRIPE_PRODUCT_ENTERPRISE": "price_1S4S4OPo0S91W8mP7gnwzZDV"
      },
      "routes": [
        {
          "custom_domain": true,
          "pattern": "stage.theringer.tech",
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_id": "9d44f697-195b-4c17-ab00-c075b69bc19b",
          "experimental_remote": true,
        }
      ],
      "services": [
        {
          "binding": "BACKEND_SERVICE",
          "service": "data-service-stage",
          "experimental_remote": true,
        },
      ]
    },
    "production": {
      "routes": [
        {
          "custom_domain": true,
          "pattern": "test-prod.theringer.tech",
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_id": "11981d1b-4668-4270-abc8-66b97b8d73fd",
        }
      ],
      "services": [
        {
          "binding": "BACKEND_SERVICE",
          "service": "data-service-production",
        },
      ]
    }
  }
}
